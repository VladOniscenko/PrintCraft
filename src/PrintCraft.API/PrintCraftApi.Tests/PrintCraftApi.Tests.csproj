    <ProjectReference Include="..\PrintCraft.Features.Orders\PrintCraft.Features.Orders.csproj" />
    <ProjectReference Include="..\PrintCraft.Features.Filaments\PrintCraft.Features.Filaments.csproj" />
    <ProjectReference Include="..\PrintCraft.Features.Payments\PrintCraft.Features.Payments.csproj" />
    <ProjectReference Include="..\PrintCraft.Features.Uploads\PrintCraft.Features.Uploads.csproj" />
    <ProjectReference Include="..\PrintCraft.Features.Content\PrintCraft.Features.Content.csproj" />
