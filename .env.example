# ------------------------------
# PrintCraft API Environment
# ------------------------------

# Database (used by docker compose + API)
POSTGRES_DB=printcraft
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# Local API runtime (dotnet run) connection string
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=printcraft;Username=admin;Password=admin

# ASP.NET Core environment: dev/Development, tst/Test, prod/Production
ASPNETCORE_ENVIRONMENT=Development

# Base URLs used by API
FrontendBaseUrl=http://localhost:5173
BackendBaseUrl=http://localhost:5001
ASPNETCORE_URLS=http://localhost:5243

# Payments
CurrencyCode=EUR

# Frontend dev server proxy target (used by frontend/vite.config.ts)
VITE_DEV_API_ORIGIN=http://localhost:5243
VITE_CURRENCY_CODE=EUR

# VS Code .http client target
PrintCraftApi_HostAddress=http://localhost:5243

# Development (local)
JwtSecret=replace-with-very-strong-dev-secret-min-32-chars
JwtIssuer=printcraft-api
JwtAudience=printcraft-client
Discord__ErrorWebhookUrl=replace-me
Discord__QuoteWebhookUrl=replace-me
Discord__BookingWebhookUrl=replace-me
Discord__PaymentReceivedWebhookUrl=replace-me

# Email provider
# Use only Email__ApiToken for consistency. MAILTRAP_API_TOKEN is not used.
Email__SmtpHost=replace-me
Email__SmtpPort=replace-me
Email__EnableSsl=true
Email__SenderName=PrintCraft
Email__SenderEmail=replace-me
Email__Username=replace-me
Email__Password=replace-me


# Bank transfer / invoice flow
BankTransfer__AccountName=Bank name
BankTransfer__Iban=Iban
BankTransfer__Bic=BIC

# Tunnel
Tunnel_Token=token

# Production note:
# In production, set the SAME variable names (JwtSecret/JwtIssuer/JwtAudience)
# through your hosting environment secret manager (not a committed file).